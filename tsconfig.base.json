{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@devflow/shared-types": ["./libs/shared/types/src/index.ts"],
      "@devflow/shared-utils": ["./libs/shared/utils/src/index.ts"],
      "@devflow/shared-ui": ["./libs/shared/ui/src/index.ts"],
      "@devflow/web-feature-shell": ["./libs/web/feature-shell/src/index.ts"],
      "@devflow/web-data-access": ["./libs/web/data-access/src/index.ts"],
      "@devflow/web-feature-projects": [
        "./libs/web/feature-projects/src/index.ts"
      ],
      "@devflow/web-feature-tasks": ["./libs/web/feature-tasks/src/index.ts"],
      "@devflow/web-feature-users": ["./libs/web/feature-users/src/index.ts"],
      "@devflow/web-feature-dashboard": [
        "./libs/web/feature-dashboard/src/index.ts"
      ],
      "@devflow/web-feature-auth": ["./libs/web/feature-auth/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
